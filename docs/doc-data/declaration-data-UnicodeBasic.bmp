50b7ce6b7b41711f/UnicodeBasic.lean#L187-L190"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">abbrev</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.GeneralCategory.isLetter\"><span class=\"name\">Unicode</span>.<span class=\"name\">GeneralCategory</span>.<span class=\"name\">isLetter</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Check if letter character (`L`)\n\nThis is a derived category (`L = Lu | Ll | Lt | Lm | Lo`).\n\nUnicode property: `General_Category=L` ","docLink":"./UnicodeBasic.html#Unicode.GeneralCategory.isLetter","kind":"def","line":180,"name":"Unicode.GeneralCategory.isLetter","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L180-L185"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.instDecidableMemCharGC\"><span class=\"name\">Unicode</span>.<span class=\"name\">instDecidableMemCharGC</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">cat</span> : <a href=\"./UnicodeBasic/Types.html#Unicode.GC\">GC</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Decidable\">Decidable</a> (<span class=\"fn\">char</span> <a href=\"./Init/Prelude.html#Membership.mem\">∈</a> <span class=\"fn\">cat</span>)</span></div></div>","info":{"doc":"","docLink":"./UnicodeBasic.html#Unicode.instDecidableMemCharGC","kind":"instance","line":176,"name":"Unicode.instDecidableMemCharGC","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L176-L176"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.instMembershipCharGC\"><span class=\"name\">Unicode</span>.<span class=\"name\">instMembershipCharGC</span></a></span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Membership\">Membership</a> <a href=\"./Init/Prelude.html#Char\">Char</a> <a href=\"./UnicodeBasic/Types.html#Unicode.GC\">GC</a></span></div></div>","info":{"doc":"`char ∈ cat` holds when the general category of `char` is included in `cat` ","docLink":"./UnicodeBasic.html#Unicode.instMembershipCharGC","kind":"instance","line":172,"name":"Unicode.instMembershipCharGC","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L172-L174"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.getGC\"><span class=\"name\">Unicode</span>.<span class=\"name\">getGC</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./UnicodeBasic/Types.html#Unicode.GC\">GC</a></div></div>","info":{"doc":"Get character general category\n\n*Caveat*: This function never returns a derived general category. Use\n`char ∈ cat` to check whether a character belongs to a general category\n`cat` (derived or not).\n\nUnicode property: `General_Category` ","docLink":"./UnicodeBasic.html#Unicode.getGC","kind":"def","line":147,"name":"Unicode.getGC","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L147-L170"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.isBidiControl\"><span class=\"name\">Unicode</span>.<span class=\"name\">isBidiControl</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Check if bidirectional control character\n\nUnicode property: `Bidi_Control` ","docLink":"./UnicodeBasic.html#Unicode.isBidiControl","kind":"def","line":132,"name":"Unicode.isBidiControl","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L132-L141"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.isBidiMirrored\"><span class=\"name\">Unicode</span>.<span class=\"name\">isBidiMirrored</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#Bool\">Bool</a></div></div>","info":{"doc":"Check if bidirectional mirrored character\n\nUnicode property: `Bidi_Mirrored` ","docLink":"./UnicodeBasic.html#Unicode.isBidiMirrored","kind":"def","line":126,"name":"Unicode.isBidiMirrored","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L126-L130"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.getBidiClass\"><span class=\"name\">Unicode</span>.<span class=\"name\">getBidiClass</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./UnicodeBasic/Types.html#Unicode.BidiClass\">BidiClass</a></div></div>","info":{"doc":"Get character bidirectional class\n\nUnicode property: `Bidi_Class` ","docLink":"./UnicodeBasic.html#Unicode.getBidiClass","kind":"def","line":120,"name":"Unicode.getBidiClass","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L120-L124"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.getScriptSet\"><span class=\"name\">Unicode</span>.<span class=\"name\">getScriptSet</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./UnicodeBasic/Types.html#Unicode.ScriptSet\">ScriptSet</a></div></div>","info":{"doc":"Get the set of scripts a character is commonly used with\n\nIf Unicode lists no such set for the character, this contains only `getScript char`.\n\nNote: despite its name, the `Script_Extensions` property does not extend the `Script`\nproperty. A set contains either one implicit script (`Zyyy` or `Zinh`) or one or more\nexplicit scripts ([UAX #24, Section 3.1](https://www.unicode.org/reports/tr24/#Script_Extensions_Def)).\nSo a character whose script is `Zyyy` (Common) or `Zinh` (Inherited) may get a set that\nexcludes its script: U+00B7 MIDDLE DOT has script `Zyyy`, but its set is `Avst Cari Copt …`.\n\nUnicode property: `Script_Extensions`\n","docLink":"./UnicodeBasic.html#Unicode.getScriptSet","kind":"def","line":101,"name":"Unicode.getScriptSet","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L101-L114"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.getScriptName?\"><span class=\"name\">Unicode</span>.<span class=\"name\">getScriptName?</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./UnicodeBasic/Types.html#Unicode.Script\">Script</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#String\">String</a></span></div></div>","info":{"doc":"Get script name\n\nReturns the long name of the script, for example `\"Latin\"` for `Latn`.\nReturns `none` if the script code is not assigned to a script.\n\nUnicode property: `Script`\n","docLink":"./UnicodeBasic.html#Unicode.getScriptName?","kind":"def","line":90,"name":"Unicode.getScriptName?","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L90-L99"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.getScript\"><span class=\"name\">Unicode</span>.<span class=\"name\">getScript</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./UnicodeBasic/Types.html#Unicode.Script\">Script</a></div></div>","info":{"doc":"Get character script\n\nReturns `Zzzz` (Unknown) for unassigned, private use and noncharacter code\npoints.\n\nUnicode property: `Script`\n","docLink":"./UnicodeBasic.html#Unicode.getScript","kind":"def","line":80,"name":"Unicode.getScript","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L80-L88"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span>\n<span class=\"decl_name\"><a class=\"break_within\" href=\"./UnicodeBasic.html#Unicode.getName\"><span class=\"name\">Unicode</span>.<span class=\"name\">getName</span></a></span><span class=\"decl_args\">\n<span class=\"fn\">(<span class=\"fn\">char</span> : <a href=\"./Init/Prelude.html#Char\">Char</a>)</span></span>\n<span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#String\">String</a></div></div>","info":{"doc":"Get character name\n\nWhen the Unicode property `Name` is empty, a unique code point label is\nreturned as recommended in Unicode Standard, section 4.8, for example\n`<control-0009>` or `<private-use-E000>`. These labels start with `'<'`\n(U+003C) and end with `'>'` (U+003E) so they are distinguishable from\nactual name values.\n\nUnicode property: `Name`\n","docLink":"./UnicodeBasic.html#Unicode.getName","kind":"def","line":63,"name":"Unicode.getName","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/6e48acac3a91665fcdc4a20d50b7ce6b7b41711f/UnicodeBasic.lean#L63-L74"}}],"imports":["Init","UnicodeBasic.TableLookup","UnicodeBasic.Types"],"instances":[{"className":"Membership","name":"Unicode.instMembershipCharGC","typeNames":["Char","Unicode.GC"]},{"className":"Decidable","name":"Unicode.instDecidableMemCharGC","typeNames":["Membership.mem"]}],"name":"UnicodeBasic"}