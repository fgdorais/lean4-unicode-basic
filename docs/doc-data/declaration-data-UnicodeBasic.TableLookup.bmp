ais/lean4-unicode-basic/blob/3a0e60a84c672431415e2cf664b6fc143f10e930/UnicodeBasic/TableLookup.lean#L236-L240"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeBasic/TableLookup.html#Unicode.lookupDecompositionMapping?\"><span class=\"name\">Unicode</span>.<span class=\"name\">lookupDecompositionMapping?</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./UnicodeBasic/Types.html#Unicode.DecompositionMapping\">DecompositionMapping</a></span></div></div>","info":{"doc":"Get decomposition mapping using lookup table\n\nUnicode properties:\n`Decomposition_Mapping`\n`Decomposition_Type`","docLink":"./UnicodeBasic/TableLookup.html#Unicode.lookupDecompositionMapping?","kind":"def","line":194,"name":"Unicode.lookupDecompositionMapping?","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/3a0e60a84c672431415e2cf664b6fc143f10e930/UnicodeBasic/TableLookup.lean#L194-L234"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeBasic/TableLookup.html#Unicode.lookupSpecialCasing\"><span class=\"name\">Unicode</span>.<span class=\"name\">lookupSpecialCasing</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span></div></div>","info":{"doc":"Get full case mappings of a code point using lookup table\n\nReturns `(l, t, u)` where `l` is the full lowercase mapping, or `[]` if it\nagrees with the simple lowercase mapping, and similarly `t` for titlecase and\n`u` for uppercase. Only unconditional mappings are included.\n\nUnicode properties:\n  `Lowercase_Mapping`\n  `Titlecase_Mapping`\n  `Uppercase_Mapping`","docLink":"./UnicodeBasic/TableLookup.html#Unicode.lookupSpecialCasing","kind":"def","line":171,"name":"Unicode.lookupSpecialCasing","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/3a0e60a84c672431415e2cf664b6fc143f10e930/UnicodeBasic/TableLookup.lean#L171-L192"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeBasic/TableLookup.html#Unicode.lookupCaseMapping\"><span class=\"name\">Unicode</span>.<span class=\"name\">lookupCaseMapping</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><a href=\"./Init/Prelude.html#UInt32\">UInt32</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></div></div>","info":{"doc":"Get simple case mappings of a code point using lookup table\n\nUnicode properties:\n`Simple_Lowercase_Mapping`\n`Simple_Uppercase_Mapping`\n`Simple_Titlecase_Mapping`","docLink":"./UnicodeBasic/TableLookup.html#Unicode.lookupCaseMapping","kind":"def","line":156,"name":"Unicode.lookupCaseMapping","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/3a0e60a84c672431415e2cf664b6fc143f10e930/UnicodeBasic/TableLookup.lean#L156-L169"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeBasic/TableLookup.html#Unicode.lookupCaseFolding\"><span class=\"name\">Unicode</span>.<span class=\"name\">lookupCaseFolding</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#Option\">Option</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#List\">List</a> <a href=\"./Init/Prelude.html#UInt32\">UInt32</a></span></div></div>","info":{"doc":"Get simple and full case foldings of a code point using lookup table\n\nReturns `(s, f)` where `s` is the simple case folding, or `none` if the code\npoint folds to itself, and `f` is the full case folding, or `[]` if it agrees\nwith the simple case folding.\n\nUnicode properties:\n  `Case_Folding`\n  `Simple_Case_Folding`","docLink":"./UnicodeBasic/TableLookup.html#Unicode.lookupCaseFolding","kind":"def","line":134,"name":"Unicode.lookupCaseFolding","sourceLink":"https://github.com/fgdorais/lean4-unicode-basic/blob/3a0e60a84c672431415e2cf664b6fc143f10e930/UnicodeBasic/TableLookup.lean#L134-L154"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeBasic/TableLookup.html#Unicode.lookupCanonicalDecompositionMapping\"><span class=\"name\">Unicode</span>.<span class=\"name\">lookupCanonicalDecompositionMapping</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">c</span> : <a href=\"./Init/Prelude.html#UInt32\">UInt32</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><spa